# Copy to .env and adjust. Never commit the real .env file.

# --- Runtime -----------------------------------------------------------------
# development | test | production. Production refuses to start without a secret key.
WATCHPOST_ENV=development

# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to get a random key per start (sessions reset on restart).
WATCHPOST_SECRET_KEY=

# DEBUG | INFO | WARNING | ERROR
WATCHPOST_LOG_LEVEL=INFO
# text (readable) or json (one object per line, for log shippers)
WATCHPOST_LOG_FORMAT=json

# Comma-separated list of browser origins allowed to call the API. No wildcards.
WATCHPOST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Ingestion ------------------------------------------------------------------
# Largest accepted upload in bytes (default 512 MiB). The limit in
# frontend/nginx.conf must be at least this large.
WATCHPOST_MAX_UPLOAD_BYTES=536870912
# How often the worker scans ./watch for new files, in seconds (5-60).
WATCHPOST_WATCH_INTERVAL_SECONDS=10
# WATCHPOST_WATCH_ENABLED=true
# Keep uploaded files after ingestion instead of deleting them.
# WATCHPOST_KEEP_UPLOADS=false

# --- Threat intelligence enrichment (optional) ----------------------------------
# Leave empty to work fully offline: alerts are still enriched from the local
# indicator store. With a key set, public IPs, domains and file hashes found in
# alerts are looked up online; private and reserved addresses never are.
WATCHPOST_ABUSEIPDB_API_KEY=
WATCHPOST_VIRUSTOTAL_API_KEY=
# Hours a lookup result is reused before asking the provider again.
WATCHPOST_ENRICHMENT_CACHE_HOURS=24
# Request budgets, shared by the API and the worker (defaults match free tiers).
# WATCHPOST_ABUSEIPDB_DAILY_LIMIT=1000
# WATCHPOST_VIRUSTOTAL_PER_MINUTE=4
# WATCHPOST_VIRUSTOTAL_DAILY_LIMIT=500

# --- PostgreSQL (used by docker compose to build WATCHPOST_DATABASE_URL) -------
POSTGRES_USER=watchpost
POSTGRES_PASSWORD=change-me
POSTGRES_DB=watchpost

# When running the API outside Docker, set the URL directly instead:
# WATCHPOST_DATABASE_URL=postgresql+asyncpg://watchpost:change-me@localhost:5432/watchpost
# WATCHPOST_REDIS_URL=redis://localhost:6379/0

# --- Host ports (bound to 127.0.0.1) -------------------------------------------
WATCHPOST_UI_PORT=3000
WATCHPOST_API_PORT=8000
WATCHPOST_DB_PORT=5432
